#!/bin/bash
#
# CHECK INPUT DATA
function usage() {
        echo "Usage: $0 [--photo PHOTOPATH] [--caption CAPTION] <message>
You can pass message to stdin also."
}

# Parse --photo/--caption before positional args
PHOTO_PATH=""
PHOTO_CAPTION=""
POSITIONAL_ARGS=()

while [[ $# -gt 0 ]]; do
        case $1 in
                --photo)
                        if [ $# -lt 2 ] || [[ "$2" == --* ]]; then
                                echo "Error: --photo requires a path" >&2
                                exit 1
                        fi
                        PHOTO_PATH="$2"; shift 2
                        ;;
                --caption)
                        if [ $# -lt 2 ] || [[ "$2" == --* ]]; then
                                echo "Error: --caption requires a caption" >&2
                                exit 1
                        fi
                        PHOTO_CAPTION="$2"; shift 2
                        ;;
                *)  POSITIONAL_ARGS+=("$1"); shift
        esac
done

[ -n "$PHOTO_CAPTION" ] && [ -z "$PHOTO_PATH" ] && { echo "Error: --caption needs --photo" >&2; exit 1; }

# Override from queue (env vars) if present
PHOTO_PATH=${TELEGRAM_SENDER_PHOTO_FILE:-$PHOTO_PATH}
PHOTO_CAPTION=${TELEGRAM_SENDER_CAPTION:-$PHOTO_CAPTION}

MESSAGE="${POSITIONAL_ARGS[*]}"
# Only read from STDIN if not in photo mode (photo mode uses --caption, not message)
if [ -z "$MESSAGE" ] && [ -z "$PHOTO_PATH" ]; then
        MESSAGE=$(cat)
fi

if [ "$MESSAGE" == "--help" ]; then
        usage
        exit 0
fi

# READ CONFIG
# TOKEN and CHAT_ID variables must be defined in config file
CONFIG_HOME="$HOME/.telegram-sender.conf"
CONFIG_ETC="/etc/telegram-sender.conf"
if [ -n "$TELEGRAM_SENDER_CONFIG_FILE" ]; then # Check enviroment variable
        ACTUAL_CONFIG_FILE="$TELEGRAM_SENDER_CONFIG_FILE"
else
        if [ -r "$CONFIG_HOME" ]; then
                ACTUAL_CONFIG_FILE="$CONFIG_HOME"
        elif [ -r "$CONFIG_ETC" ]; then
                ACTUAL_CONFIG_FILE="$CONFIG_ETC"
        else
                echo "Can not read config from $CONFIG_HOME or $CONFIG_ETC. Exit." >&2
                exit 1 
        fi
fi
. $ACTUAL_CONFIG_FILE

# Use enviroment variables if specified
ACTUAL_CHAT_ID=${TELEGRAM_SENDER_CHAT_ID:-$CHAT_ID} 
ACTUAL_TOKEN=${TELEGRAM_SENDER_TOKEN:-$TOKEN}
ACTUAL_QUEUE_FILE=${TELEGRAM_SENDER_QUEUE_FILE:-${QUEUE_FILE:-"/var/tmp/telegram-sender-queue.$(id -un)"}}
ACTUAL_PROXY=${TELEGRAM_SENDER_PROXY:-$PROXY}
ACTUAL_QUEUE_DIR=${TELEGRAM_SENDER_QUEUE_DIR:-${QUEUE_DIR:-"/var/tmp/telegram-sender-queue-files.$(id -un)"}}

# SEND REQUEST: photo or text
[[ -n "$ACTUAL_PROXY" ]] && CURL_PROXY_PARAM="--proxy $ACTUAL_PROXY"

if [ -n "$PHOTO_PATH" ]; then
        # Send photo with caption or just photo
        CURL_PARAMS=(
            --connect-timeout 10 --max-time 60
            $CURL_PROXY_PARAM
            -w "%{http_code}" -s -q -o /dev/null
            -X POST "https://api.telegram.org/bot$ACTUAL_TOKEN/sendPhoto"
            -F "chat_id=$ACTUAL_CHAT_ID"
            -F "photo=@$PHOTO_PATH"
        )
        [ -n "$PHOTO_CAPTION" ] && CURL_PARAMS+=(-F "caption=$PHOTO_CAPTION")
        HTTP_RETURN_CODE=$(curl "${CURL_PARAMS[@]}" 2>&1)
else
        HTTP_RETURN_CODE=$(curl --connect-timeout 10 --max-time 30 \
                $CURL_PROXY_PARAM \
                -w "%{http_code}" -s -q -o /dev/null -X POST "https://api.telegram.org/bot$ACTUAL_TOKEN/sendMessage" \
                -d chat_id=$ACTUAL_CHAT_ID \
                --data-urlencode text="$MESSAGE" 2>&1 )
fi
CURL_RETURN_CODE=$?

ACTUAL_USE_QUEUE=${TELEGRAM_SENDER_USE_QUEUE:-${USE_QUEUE:-1}} #Default value 1, check two vars before


if [ "$CURL_RETURN_CODE" != "0" -o "$HTTP_RETURN_CODE" != "200" ]; then
        if [ "$ACTUAL_USE_QUEUE" == "1" ]; then
                test -d "$ACTUAL_QUEUE_DIR" || mkdir -p "$ACTUAL_QUEUE_DIR"
                DT_FORMATED=`date "+$QUEUE_DATETIME_FORMAT"`
                if [ -n "$PHOTO_PATH" ]; then
                        # Move photo into queue dir so queue script can find it later
                        PHOTO_BASENAME=$(basename "$PHOTO_PATH")
                        PHOTO_QUEUE_NAME="${DT_FORMATED//:/}-$(date +%s%N | tail -c 6)-$PHOTO_BASENAME"
                        mv "$PHOTO_PATH" "$ACTUAL_QUEUE_DIR/$PHOTO_QUEUE_NAME"
                        echo "$DT_FORMATED|$ADD_DATETIME_IN_QUEUE_MSG|$ACTUAL_CHAT_ID|$ACTUAL_CONFIG_FILE|$PHOTO_QUEUE_NAME|$PHOTO_CAPTION" >> "$ACTUAL_QUEUE_FILE"
                else
                        # Change new line char with awk for avoid use sed with -z option, which does not present in BusyBox
                        MESSAGE_CHANGED=$(echo "$MESSAGE"| awk '{printf "%s<NEWLINE>", $0}')
                        echo "$DT_FORMATED|$ADD_DATETIME_IN_QUEUE_MSG|$ACTUAL_CHAT_ID|$ACTUAL_CONFIG_FILE|$MESSAGE_CHANGED" >> "$ACTUAL_QUEUE_FILE"
                fi
                exit 0
        fi
        exit 2
fi
exit 0
