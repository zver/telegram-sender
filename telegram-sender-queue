#!/bin/bash
# Telegram message queue processor
#
# Queue formats:
#   Text (5 fields): DT|ADD_DT|CHAT_ID|CONFIG_FILE|MESSAGE
#   Media (6 fields): DT|ADD_DT|CHAT_ID|CONFIG_FILE|MEDIA_QUEUE_NAME|CAPTION
#     where MEDIA_QUEUE_NAME ends in .photo (photo) or .video (video)

if [[ "${1:-}" == "--help" ]]; then
    echo "Send Telegram messages from a queue file.\nUsage:
  $0 [QUEUE_FILE|--help]

If no QUEUE_FILE is specified, a default file in /var/tmp is used."
    exit 1
fi

QUEUE_FILE="${1:-/var/tmp/telegram-sender-queue.$(id -un)}"

if [[ ! -r "$QUEUE_FILE" ]]; then
    echo "Error: cannot read from $QUEUE_FILE" >&2
    exit 1
fi

# Switch to queue file owner if running as root
if [[ "$(id -u)" -eq 0 ]]; then
    QUEUE_FILE_OWNER=$(stat -c '%U' "$QUEUE_FILE")
    if [[ "$QUEUE_FILE_OWNER" != "root" ]]; then
        echo "Switching to queue file owner: $QUEUE_FILE_OWNER..."
        exec sudo -u "$QUEUE_FILE_OWNER" -- "$0" "$@"
        exit $?
    fi
fi


LOCK_FILE="$QUEUE_FILE.lock"
QUEUE_FILE_TMP=`mktemp -u`
# Check is Lock File exists, if not create it and set trap on exit
if { set -C; 2>/dev/null >$LOCK_FILE; }; then
    trap "rm -f $LOCK_FILE $QUEUE_FILE_TMP" EXIT
else
    echo "Lock file $LOCK_FILE exists… exiting"
    exit
fi
touch $QUEUE_FILE_TMP


# Paths
REAL_SCRIPT_PATH="$(test -L "$0" && readlink "$0" || which "$0")"
TELEGRAM_SENDER="$(dirname "$REAL_SCRIPT_PATH")/telegram-sender"
ACTUAL_QUEUE_DIR=${TELEGRAM_SENDER_QUEUE_DIR:-${QUEUE_DIR:-"$(dirname "$QUEUE_FILE")/telegram-sender-queue-files.$(id -un)"}}
mkdir -p "$ACTUAL_QUEUE_DIR" 2>/dev/null || true

# Process a single queue entry (line from queue file)
# Detects 6-field photo entries vs 5-field text entries
process_queue_entry() {
    local LINE="$1"
    local DT ADD_DT CHAT_ID CONFIG_FILE FIELDS
    local FIELD5 FIELD6 PHOTO_QUEUE_NAME PHOTO_CAPTION DT_TEXT

    # Count pipe-separated fields to detect photo vs text
    FIELDS=$(awk -F'|' '{print NF}' <<< "$LINE")
    DT="$(echo "$LINE" | cut -d'|' -f1)"
    ADD_DT="$(echo "$LINE" | cut -d'|' -f2)"
    CHAT_ID="$(echo "$LINE" | cut -d'|' -f3)"
    CONFIG_FILE="$(echo "$LINE" | cut -d'|' -f4)"
    FIELD5="$(echo "$LINE" | cut -d'|' -f5)"
    FIELD6="$(echo "$LINE" | cut -d'|' -f6)"

    [[ -z "$DT" || -z "$CONFIG_FILE" ]] && {
        echo "Skipping malformed entry: $LINE" >&2
        return 1
    }

    # Prepend datetime if configured
    if [[ "${ADD_DT:-0}" == "1" && -n "$DT" ]]; then
        DT_TEXT="[$DT] "
    else
        DT_TEXT=""
    fi

    if [[ "$FIELDS" -ge 6 ]]; then
        # Media entry: field 5 = media queue name, field 6 = caption (may be empty)
        MEDIA_QUEUE_NAME="$FIELD5"
        MEDIA_CAPTION="${FIELD6:-}"

        # Distinguish photo (.photo suffix) from video (.video suffix) entries
        case "$MEDIA_QUEUE_NAME" in
            *.photo)
                FULL_MEDIA_PATH="$ACTUAL_QUEUE_DIR/$MEDIA_QUEUE_NAME"
                if [[ ! -f "$FULL_MEDIA_PATH" ]]; then
                    echo "Warning: photo file not found: $FULL_MEDIA_PATH — queueing for retry" >&2
                    return 1
                fi

                echo -e "${DT_TEXT}[SEND PHOTO] $MEDIA_QUEUE_NAME" >&2

                local RET=0
                local CAP_ARG=()
                [ -n "$MEDIA_CAPTION" ] && CAP_ARG=(--caption "$MEDIA_CAPTION")
                    TELEGRAM_SENDER_USE_QUEUE=0 \
                    TELEGRAM_SENDER_CHAT_ID="$CHAT_ID" \
                    TELEGRAM_SENDER_CONFIG_FILE="$CONFIG_FILE" \
                    "$TELEGRAM_SENDER" --photo "$FULL_MEDIA_PATH" "${CAP_ARG[@]}" || RET=$?
                echo "PHOTO RET: $RET"
                if [[ $RET -eq 0 ]]; then
                    rm -f "$FULL_MEDIA_PATH"
                    return 0
                fi

                # Failed — requeue
                echo "$LINE" >> "$QUEUE_FILE_TMP"
                return 1
                ;;
            *.video)
                FULL_MEDIA_PATH="$ACTUAL_QUEUE_DIR/$MEDIA_QUEUE_NAME"
                if [[ ! -f "$FULL_MEDIA_PATH" ]]; then
                    echo "Warning: video file not found: $FULL_MEDIA_PATH — queueing for retry" >&2
                    return 1
                fi

                echo -e "${DT_TEXT}[SEND VIDEO] $MEDIA_QUEUE_NAME" >&2

                local RET=0
                local CAP_ARG=()
                [ -n "$MEDIA_CAPTION" ] && CAP_ARG=(--caption "$MEDIA_CAPTION")
                    TELEGRAM_SENDER_USE_QUEUE=0 \
                    TELEGRAM_SENDER_CHAT_ID="$CHAT_ID" \
                    TELEGRAM_SENDER_CONFIG_FILE="$CONFIG_FILE" \
                    "$TELEGRAM_SENDER" --video "$FULL_MEDIA_PATH" "${CAP_ARG[@]}" || RET=$?
                echo "VIDEO RET: $RET"
                if [[ $RET -eq 0 ]]; then
                    rm -f "$FULL_MEDIA_PATH"
                    return 0
                fi

                # Failed — requeue
                echo "$LINE" >> "$QUEUE_FILE_TMP"
                return 1
                ;;
            *)
                echo "Warning: unknown media queue file extension: $MEDIA_QUEUE_NAME — skipping" >&2
                return 1
                ;;
        esac
    else
        # Text entry: field 5 = message (multi-line encoded as <NEWLINE>)
        local MESSAGE="$FIELD5"

        # Decode encoded newlines for display
        local DISPLAY_MSG
        DISPLAY_MSG="$(echo "$MESSAGE" | sed 's/<NEWLINE>/\\n/g')"

        echo -e "${DT_TEXT}${DISPLAY_MSG}" >&2

        local RET=0
        printf '%s' "$MESSAGE" |
            sed 's/<NEWLINE>/\n/g' |
            env \
                TELEGRAM_SENDER_USE_QUEUE=0 \
                TELEGRAM_SENDER_CHAT_ID="$CHAT_ID" \
                TELEGRAM_SENDER_CONFIG_FILE="$CONFIG_FILE" \
                "$TELEGRAM_SENDER" || RET=$?

        if [[ $RET -ne 0 ]]; then
            # Failed — requeue
            echo "$LINE" >> "$QUEUE_FILE_TMP"
            return 1
        fi
        return 0
    fi
}

# Read and process queue entries
while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    process_queue_entry "$line"
done < "$QUEUE_FILE"

cat "$QUEUE_FILE_TMP" >| "$QUEUE_FILE"
